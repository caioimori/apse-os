{
  "name": "apseos",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "depcheck": "depcruise --config .dependency-cruiser.cjs packages apps 2>/dev/null || echo 'depcheck skipped — no code workspace yet'",
    "secretlint": "secretlint '**/*'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@secretlint/secretlint-rule-pattern": "^8.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "^8.2.4",
    "dependency-cruiser": "^16.0.0",
    "husky": "^9.1.6",
    "secretlint": "^8.2.4"
  }
}
