# ------------------------------------------------------------------
# ApseOS — variáveis de ambiente (template)
# Copie para .env.local e preencha conforme necessário.
# ------------------------------------------------------------------

# ------ Supabase (local via `pnpm db:start`) ----------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------ Integration modes: mock | sandbox | production ------------
# MVP roda tudo em "mock" por padrão (localhost-first).
APSE_ASAAS_MODE=mock
APSE_RESEND_MODE=mock
APSE_SONAR_MODE=mock
APSE_PIPEDRIVE_MODE=mock
APSE_CLAUDE_MODE=mock

# ------ Asaas (quando modo != mock) -------------------------------
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

# ------ Resend ----------------------------------------------------
RESEND_API_KEY=

# ------ Sonar CRM (quando integrar) -------------------------------
SONAR_API_KEY=

# ------ Pipedrive CRM (quando integrar) ---------------------------
PIPEDRIVE_API_TOKEN=

# ------ NUNCA PREENCHER (regra NON-NEGOTIABLE) --------------------
# Ver docs/strategy/decisao-claude-max-nao-api.md
# ANTHROPIC_API_KEY=  ← PROIBIDO no MVP

# ------ Observability ---------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ------ App -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
